<section class="section v3-about-section" id="about-v3">
  <div class="container v3-about-grid">
    <img src="https://apnibusassetsgroup87b2.blob.core.windows.net/apnibus-tenant-sites/dipesh_jain/png1790163140739.png" class="v3-about-img" alt="Mahaveer Bus Service Fleet">
    <div>
      <h2 class="section-title-v3" data-i18n="indexV3.about.heading">About Operator</h2>
      <div class="v3-about-text" id="v3AboutTextIntro"></div>
      <div class="v3-about-stats">
        <div><strong id="aboutBusesCount">1</strong><span data-i18n="indexV3.about.statsBuses">Buses in Fleet</span></div>
        <div><strong id="aboutRoutesCount">1</strong><span data-i18n="indexV3.about.statsRoutes">Active Routes</span></div>
        <div><strong>1951</strong><span data-i18n="indexV3.about.statsSince">Serving Since</span></div>
        <div><strong>Bharatpur</strong><span><span data-i18n-swap="text" data-hi-text="राजस्थान">Rajasthan</span> <span data-i18n="indexV3.about.statsBased">Based</span></span></div>
      </div>
